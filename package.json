{
  "name": "quizforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "models": "node scripts/list-models.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "3.859.0",
    "concurrently": "9.2.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
