# このファイルをコピーして .env を作成します（.env は git 管理外）。

AWS_REGION=us-east-1

# Bedrock コンソール → 「API キー」 で発行した値。
# = の後ろに引用符やスペースを付けないこと。
# 環境変数名はこの綴りでなければ SDK が拾わないので変更しないこと。
AWS_BEARER_TOKEN_BEDROCK=

# 代わりに IAM のアクセスキーを使う場合はこちら（APIキーを使うなら不要）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default

# ここのモデル指定は「初期値」です。管理画面の「AI」タブで切り替えると
# DB（app_settings テーブル）の値が優先され、この3行は無視されます。

# 作問に使う Bedrock モデル。
# 授業資料（PDF/Word/画像）をそのまま渡す設計なので、document と image の
# 入力に対応したモデルが必要です。Claude 系を推奨。
# ID は必ず `npm run models opus` で自分のリージョンの実物を確認してください。
# クロスリージョン推論プロファイル（us. / eu. / apac. / global. 接頭辞）が必要なモデルもあります。
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5

# 記述式の採点に使うモデル（未指定なら BEDROCK_MODEL_ID を使用）。
# 採点は資料を読まないテキスト処理なので、安いモデルに分けても精度は落ちにくい。
# テキスト専用モデル（zai.glm-5 など）でも動く。
# BEDROCK_GRADER_MODEL_ID=zai.glm-5

# 「AI解説」ボタンで使うモデル（未指定なら BEDROCK_MODEL_ID を使用）。
# BEDROCK_EXPLAINER_MODEL_ID=zai.glm-5

PORT=8787

# ---------- Postgres ----------
DATABASE_URL=postgres://quizforge:password@localhost:5432/quizforge
# 自己署名証明書のサーバに繋ぐ場合のみ
# PGSSL=1
# PGSSL_NO_VERIFY=1

# ---------- ユーザー管理 ----------
# 新規登録に必要な招待コード。空だと登録を一切受け付けない。
SIGNUP_CODE=

# 管理者アカウント。このアカウントだけが /admin に入れる。
# 両方埋めると起動時に users テーブルへ作成／更新される。
# 空のままだと管理画面は使えない（フェイルクローズ）。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# セッションの有効日数
SESSION_DAYS=30

# クッキーの Secure 属性。空欄なら X-Forwarded-Proto から自動判定する
# （Cloudflare Tunnel 経由なら自動で付く）。1 で強制、0 で無効。
COOKIE_SECURE=

# リバースプロキシ／トンネルからの転送段数。cloudflared 直結なら 1。
TRUST_PROXY=1

# 作成回数・ファイル数・サイズ・出題数の上限は plans テーブルで管理します
# （管理画面のプラン欄から編集）。

# コスト計算の単価はモデルごとに model_prices テーブルで管理します。
# 管理画面の「モデル単価」欄から入力してください。

# HTTP ボディ上限。base64 で 4/3 に膨らむため、最上位プランの合計MBより大きく取る
MAX_BODY_SIZE=96mb

# ---------- 本番配信 ----------
# フロントのビルド成果物の場所。未指定なら server/dist から見た ../../web/dist。
# 同一オリジンで配信するので CORS_ORIGIN は不要になる。
# WEB_DIST=

# API と別オリジンから配信する場合のみ。カンマ区切り。
# CORS_ORIGIN=https://quiz.example.com
